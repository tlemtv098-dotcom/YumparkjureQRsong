# Environment variables this project actually reads.
# Copy the keys you need into your host's dashboard. See docs/deploy-render.md.

# --- Required in production -------------------------------------------------
# Signs sessions and CSRF tokens. Without it the code falls back to a fixed
# publicly known value and warns at startup. Generate with:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Persistent database. Without it the project falls back to SQLite on the
# container disk, which every deploy wipes.
#   Render internal Postgres: postgresql://user:pass@HOST/dbname
#   Managed host (Neon, Supabase): postgresql://...?sslmode=require
DATABASE_URL=

# Render's internal Postgres does not use TLS, so leave this False for it.
# Set True only for a managed host that requires it.
DATABASE_SSL_REQUIRE=False

DEBUG=False

# --- Player / owner API -----------------------------------------------------
# Header value that grants owner rights on /api/queue/, /api/block/, and the
# move/mark-played endpoints. The player page reads it from the template.
PLAYER_TOKEN=

# --- Hosting ----------------------------------------------------------------
ALLOWED_HOSTS=yumpakjure.onrender.com,.onrender.com,localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=https://yumpakjure.onrender.com

# --- External APIs (optional) ----------------------------------------------
# YouTube Data API v3, used by the search endpoint. Without it search returns
# no results.
YOUTUBE_API_KEY=

# DeepSeek, OpenAI-compatible, used by the mood recommendation endpoint.
DEEPSEEK_API_KEY=
