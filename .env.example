# Django Settings
SECRET_KEY=your-super-secret-key-here-generate-with-django-secret-key-generator
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,*.railway.app

# CSRF Trusted Origins (for production HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (optional - for PostgreSQL on Railway)
# DATABASE_URL=postgresql://user:pass@host:port/dbname